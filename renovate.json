{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Automerge patch and minor updates after CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group BullMQ and IORedis (share lock-file entries)",
      "matchPackageNames": ["bullmq", "ioredis", "@bull-board/api", "@bull-board/express"],
      "groupName": "BullMQ & Redis"
    },
    {
      "description": "Group Express and middleware",
      "matchPackageNames": ["express", "express-basic-auth", "helmet", "morgan", "@types/express", "@types/morgan"],
      "groupName": "Express & middleware"
    },
    {
      "description": "Group TypeScript type definitions",
      "matchPackageNames": ["@types/**"],
      "groupName": "TypeScript types"
    },
    {
      "description": "Group Pino logging packages",
      "matchPackageNames": ["pino", "pino-pretty"],
      "groupName": "Pino logging"
    },
    {
      "description": "Major updates require manual review — disable automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
